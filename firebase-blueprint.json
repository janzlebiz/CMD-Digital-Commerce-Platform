{
  "entities": {
    "user": {
      "title": "UserProfile",
      "description": "Secure user profile representing identities and role taxonomy.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email" },
        "firstName": { "type": "string", "maxLength": 64 },
        "lastName": { "type": "string", "maxLength": 64 },
        "phone": { "type": "string", "pattern": "^\\+639\\d{9}$" },
        "role": { "type": "string", "enum": ["customer", "staff", "practitioner", "manager", "admin"] },
        "assignedBranchId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "firstName", "lastName", "role", "createdAt", "updatedAt"]
    },
    "order": {
      "title": "OrderRecord",
      "description": "Commercial transaction and invoice record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "customer": {
          "type": "object",
          "properties": {
            "firstName": { "type": "string", "maxLength": 64 },
            "lastName": { "type": "string", "maxLength": 64 },
            "email": { "type": "string", "format": "email" },
            "phone": { "type": "string" },
            "province": { "type": "string" },
            "municipality": { "type": "string" },
            "barangay": { "type": "string" },
            "addressLine1": { "type": "string" }
          }
        },
        "items": { "type": "array" },
        "fulfillmentMethod": { "type": "string", "enum": ["pickup", "delivery"] },
        "pickupBranchId": { "type": "string" },
        "shippingFee": { "type": "number" },
        "subtotal": { "type": "number" },
        "vatAmount": { "type": "number" },
        "vatableSales": { "type": "number" },
        "nonVatSales": { "type": "number" },
        "total": { "type": "number" },
        "isVatRegistered": { "type": "boolean" },
        "paymentMethod": { "type": "string", "enum": ["gcash", "maya", "bank_transfer", "cash_on_pickup"] },
        "paymentStatus": { "type": "string", "enum": ["pending_payment", "paid", "payment_verification_required"] },
        "fulfillmentStatus": { "type": "string", "enum": ["pending_processing", "ready_for_pickup", "in_transit", "completed", "cancelled"] }
      }
    },
    "inventory": {
      "title": "InventoryRecord",
      "description": "Branch stock level tracking.",
      "type": "object",
      "properties": {
        "skuId": { "type": "string" },
        "branchId": { "type": "string" },
        "stockCount": { "type": "number" },
        "lastReplenishedAt": { "type": "string", "format": "date-time" }
      }
    },
    "consultation": {
      "title": "ConsultationIntake",
      "description": "Patient wellness intake form.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "practitionerId": { "type": "string" },
        "scheduledAt": { "type": "string", "format": "date-time" },
        "deliveryMode": { "type": "string", "enum": ["in_person", "virtual", "followup"] },
        "consentRecord": { "type": "object" },
        "encryptedClinicalIntake": { "type": "object" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "User profile collection."
    },
    "/orders/{orderId}": {
      "schema": "order",
      "description": "Order records collection."
    },
    "/branch_inventory/{inventoryId}": {
      "schema": "inventory",
      "description": "Branch-specific stock volumes."
    },
    "/consultation_intakes/{intakeId}": {
      "schema": "consultation",
      "description": "Consultation intake and encrypted clinical information."
    }
  }
}
