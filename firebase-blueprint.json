{
  "entities": {
    "user": {
      "title": "UserProfile",
      "description": "User profile with role-based access control.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "practitioner", "branch_manager", "regional_director", "super_admin"] },
        "assignedBranchId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "order": {
      "title": "OrderRecord",
      "description": "Order placement record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "customer": { "type": "object" },
        "items": { "type": "array" },
        "branchId": { "type": "string" },
        "deliveryMethod": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "fulfillmentStatus": { "type": "string" },
        "subtotal": { "type": "number" },
        "shippingFee": { "type": "number" },
        "taxAmount": { "type": "number" },
        "grandTotal": { "type": "number" },
        "placedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "branchId", "items", "grandTotal", "paymentStatus", "fulfillmentStatus"]
    },
    "inventory": {
      "title": "BranchInventory",
      "description": "Branch-specific inventory stock balance.",
      "type": "object",
      "properties": {
        "stockCount": { "type": "number" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["stockCount"]
    },
    "consultation": {
      "title": "ConsultationIntake",
      "description": "Patient wellness intake form.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "practitionerId": { "type": "string" },
        "scheduledAt": { "type": "string", "format": "date-time" },
        "deliveryMode": { "type": "string", "enum": ["in_person", "virtual", "followup"] },
        "consentRecord": { "type": "object" },
        "encryptedClinicalIntake": { "type": "object" }
      }
    },
    "consultation_appointment": {
      "title": "ConsultationAppointment",
      "description": "Scheduled wellness consultation booking record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string", "format": "email" },
        "customerPhone": { "type": "string" },
        "practitionerId": { "type": "string" },
        "practitionerName": { "type": "string" },
        "serviceCode": { "type": "string", "enum": ["CNS-IN-PERSON", "CNS-VIRTUAL", "CNS-FOLLOWUP"] },
        "serviceTitle": { "type": "string" },
        "deliveryMode": { "type": "string", "enum": ["in_person", "virtual"] },
        "branchId": { "type": "string" },
        "scheduledDate": { "type": "string" },
        "scheduledTime": { "type": "string" },
        "status": { "type": "string", "enum": ["scheduled", "intake_completed", "in_consultation", "completed", "cancelled"] },
        "intakeId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "practitionerId", "serviceCode", "scheduledDate", "scheduledTime", "status", "createdAt"]
    },
    "audit_log": {
      "title": "AuditLogRecord",
      "description": "Server-authoritative append-only administrative and security event log.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "actorUid": { "type": "string" },
        "actorRole": { "type": "string" },
        "branchId": { "type": "string" },
        "action": { "type": "string" },
        "targetResource": { "type": "string" },
        "targetId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "success": { "type": "boolean" },
        "metadata": { "type": "object" },
        "correlationId": { "type": "string" }
      },
      "required": ["id", "actorUid", "actorRole", "action", "targetResource", "timestamp", "success"]
    },
    "workshop": {
      "title": "Workshop",
      "description": "Branch-specific educational workshop or community wellness symposium.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "branchId": { "type": "string" },
        "scheduledDate": { "type": "string" },
        "scheduledTime": { "type": "string" },
        "capacity": { "type": "number" },
        "seatsAllocated": { "type": "number" },
        "waitlistCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "branchId", "scheduledDate", "scheduledTime", "capacity", "seatsAllocated", "waitlistCount"]
    },
    "workshop_registration": {
      "title": "WorkshopRegistration",
      "description": "User registration for an educational workshop.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "workshopId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerPhone": { "type": "string" },
        "status": { "type": "string", "enum": ["confirmed", "waitlisted", "cancelled", "attended"] },
        "signature": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "workshopId", "status", "signature"]
    },
    "support_ticket": {
      "title": "SupportTicket",
      "description": "RA 11967 Consumer dispute and redress support tickets with 7-day statutory SLA.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerPhone": { "type": "string" },
        "orderId": { "type": "string" },
        "branchId": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["damaged_product", "delivery_delay", "billing_issue", "product_inquiry", "statutory_dpa_inquiry", "wrong_item", "cancellation_refund"]
        },
        "subject": { "type": "string" },
        "description": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["submitted", "under_investigation", "escalated_sla_breach", "resolved", "closed"]
        },
        "slaDueAt": { "type": "string", "format": "date-time" },
        "isEscalated": { "type": "boolean" },
        "resolutionSummary": { "type": "string" },
        "resolvedAt": { "type": "string", "format": "date-time" },
        "resolvedByUid": { "type": "string" },
        "resolvedByName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "customerName", "customerEmail", "branchId", "category", "subject", "description", "status", "slaDueAt", "isEscalated", "createdAt"]
    },
    "expense": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "branchId": { "type": "string" },
        "category": {
          "type": "string",
          "enum": [
            "procurement_raw_materials",
            "packaging_bottles_droppers",
            "agricultural_copra_processing",
            "agricultural_rice_milling",
            "branch_rent_utilities",
            "logistics_freight",
            "practitioner_stipends",
            "marketing_symposia",
            "miscellaneous"
          ]
        },
        "description": { "type": "string" },
        "amount": { "type": "number", "minimum": 0 },
        "expenseStatus": {
          "type": "string",
          "enum": ["paid", "incurred_pending_payment"]
        },
        "incurredAt": { "type": "string", "format": "date-time" },
        "paidAt": { "type": "string", "format": "date-time" },
        "paymentReference": { "type": "string" },
        "commodityMetadata": {
          "type": "object",
          "properties": {
            "commodityType": { "type": "string", "enum": ["rice", "copra"] },
            "volumeKg": { "type": "number" },
            "acquisitionCostPerKg": { "type": "number" },
            "millingOrDryingFee": { "type": "number" },
            "notes": { "type": "string" }
          }
        },
        "recordedByUid": { "type": "string" },
        "recordedByName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "branchId", "category", "description", "amount", "expenseStatus", "incurredAt", "recordedByUid", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "User profile collection."
    },
    "/orders/{orderId}": {
      "schema": "order",
      "description": "Order records collection."
    },
    "/branch_inventory/{inventoryId}": {
      "schema": "inventory",
      "description": "Branch-specific stock volumes."
    },
    "/consultation_intakes/{intakeId}": {
      "schema": "consultation",
      "description": "Consultation intake and encrypted clinical information."
    },
    "/consultation_appointments/{appointmentId}": {
      "schema": "consultation_appointment",
      "description": "Consultation appointments and scheduling records."
    },
    "/audit_logs/{logId}": {
      "schema": "audit_log",
      "description": "Append-only structured audit logs."
    },
    "/workshops/{workshopId}": {
      "schema": "workshop",
      "description": "Workshop scheduled events."
    },
    "/workshop_registrations/{regId}": {
      "schema": "workshop_registration",
      "description": "User workshop registrations."
    },
    "/support_tickets/{ticketId}": {
      "schema": "support_ticket",
      "description": "Consumer dispute and redress tickets under RA 11967."
    },
    "/expenses/{expenseId}": {
      "schema": "expense",
      "description": "Branch expenses, procurement, and agricultural commodity processing costs."
    }
  }
}
