rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBranchManager() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'branch_manager';
    }

    function isRegionalDirector() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'regional_director';
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isBranchManager() || isRegionalDirector() || isSuperAdmin();
      allow list: if isRegionalDirector() || isSuperAdmin();
      allow create: if isOwner(userId) && request.resource.data.role == 'customer';
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && (
        isOwner(resource.data.userId) ||
        (isBranchManager() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedBranchId == resource.data.branchId) ||
        isRegionalDirector() ||
        isSuperAdmin()
      );
      allow list: if isSignedIn() && (
        isBranchManager() ||
        isRegionalDirector() ||
        isSuperAdmin()
      );
      allow write: if false;
    }

    // Legacy inactive scaffold - superseded by /inventory and /branch_batch_inventory in Phase 7
    match /branch_inventory/{inventoryId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Phase 7: Multi-Branch Inventory & Authoritative Batch Tracking
    match /inventory/{itemId} {
      allow get, list: if isSignedIn() && (
        isRegionalDirector() || 
        isSuperAdmin() || 
        (isBranchManager() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedBranchId == resource.data.branchId)
      );
      allow write: if false; // ADR-009: Server-authoritative writes
    }

    match /product_batches/{batchId} {
      allow get, list: if isSignedIn() && (
        isBranchManager() || 
        isRegionalDirector() || 
        isSuperAdmin()
      );
      allow write: if false; // ADR-009: Server-authoritative writes
    }

    match /branch_batch_inventory/{itemDocId} {
      allow get, list: if isSignedIn() && (
        isRegionalDirector() || 
        isSuperAdmin() || 
        (isBranchManager() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedBranchId == resource.data.branchId)
      );
      allow write: if false; // ADR-009: Server-authoritative writes
    }

    match /inventory_adjustments/{adjustmentId} {
      allow get, list: if isSignedIn() && (
        isRegionalDirector() || 
        isSuperAdmin() || 
        (isBranchManager() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedBranchId == resource.data.branchId)
      );
      allow write: if false; // ADR-009: Server-authoritative writes
    }

    match /consultation_intakes/{intakeId} {
      allow read, write: if false;
    }

    match /consultation_appointments/{appointmentId} {
      allow get, list: if isSignedIn() && (
        isOwner(resource.data.userId) ||
        isOwner(resource.data.practitionerId) ||
        isSuperAdmin()
      );
      allow write: if false;
    }

    match /audit_logs/{logId} {
      allow get, list: if isSignedIn() && (
        isSuperAdmin() ||
        isRegionalDirector()
      );
      allow write: if false;
    }

    match /booked_slots/{slotId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /workshops/{workshopId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /workshop_registrations/{regId} {
      allow get: if isSignedIn() && (
        isOwner(resource.data.userId) ||
        isBranchManager() ||
        isRegionalDirector() ||
        isSuperAdmin()
      );
      allow list: if isSignedIn() && (
        isBranchManager() ||
        isRegionalDirector() ||
        isSuperAdmin()
      );
      allow write: if false;
    }

    match /support_tickets/{ticketId} {
      allow get: if isSignedIn() && (
        isOwner(resource.data.userId) ||
        (isBranchManager() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedBranchId == resource.data.branchId) ||
        isRegionalDirector() ||
        isSuperAdmin()
      );
      allow list: if isSignedIn() && (
        isOwner(resource.data.userId) ||
        (isBranchManager() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedBranchId == resource.data.branchId) ||
        isRegionalDirector() ||
        isSuperAdmin()
      );
      allow write: if false;
    }

    match /expenses/{expenseId} {
      allow get: if isSignedIn() && (
        (isBranchManager() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedBranchId == resource.data.branchId) ||
        isRegionalDirector() ||
        isSuperAdmin()
      );
      allow list: if isSignedIn() && (
        (isBranchManager() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedBranchId == resource.data.branchId) ||
        isRegionalDirector() ||
        isSuperAdmin()
      );
      allow write: if false;
    }

    match /b2b_stockists/{stockistId} {
      allow get, list: if isSignedIn() && (
        isRegionalDirector() || 
        isSuperAdmin() || 
        (isBranchManager() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedBranchId == resource.data.branchId)
      );
      allow write: if false; // ADR-009: Server-authoritative writes
    }

    match /b2b_ledger/{ledgerId} {
      allow get, list: if isSignedIn() && (
        isRegionalDirector() || 
        isSuperAdmin() || 
        (isBranchManager() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedBranchId == resource.data.branchId)
      );
      allow write: if false; // ADR-009: Server-authoritative writes
    }
  }
}
